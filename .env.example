# Copie para .env.local e preencha para ativar o pagamento real (Mercado Pago · Pix).
# Sem esta variável, o botão de compra fica em modo reserva (sem cobrança).
# Pegue o token em: mercadopago.com.br -> Suas integracoes -> Credenciais.
# Cadastre tambem uma CHAVE PIX na sua conta (e onde o dinheiro cai).
# Comece com o token de TESTE para validar sem cobrar de verdade.
MP_ACCESS_TOKEN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Numero do WhatsApp de atendimento (formato internacional, so digitos: 55 + DDD + numero).
# Usado no link "conversar" do rodape. Fica so no .env.local (fora do codigo versionado).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---------------- Login (Supabase Auth) ----------------
# Em supabase.com/dashboard > seu projeto > Project Settings > API:
#   NEXT_PUBLIC_SUPABASE_URL      = campo "Project URL"
#   NEXT_PUBLIC_SUPABASE_ANON_KEY = chave "anon public"
# As duas sao publicas por natureza (vao para o browser). A protecao real vem
# do Supabase, nao do sigilo delas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# O resto da configuracao de login NAO fica aqui - fica no painel do Supabase.
# Um projeto novo (ou restaurado apos hibernar) precisa refazer estes passos:
#
#   Authentication > Providers > Google
#     Ativar e colar o Client ID + Secret criados no Google Cloud.
#     O Supabase mostra nessa tela a URL de callback dele, algo como
#       https://SEU-REF.supabase.co/auth/v1/callback
#     E ESSA a URL que voce registra no Google Cloud > Clientes >
#     "URIs de redirecionamento autorizados" (correspondencia exata).
#
#   Authentication > Providers > Email
#     DESMARCAR "Confirm email". O e-mail embutido do plano gratuito envia
#     pouquissimas mensagens por hora; num congresso com dezenas de cadastros
#     na mesma noite a fila estoura e ninguem consegue entrar.
#
#   Authentication > URL Configuration
#     Site URL   = dominio de producao
#     Redirect URLs = http://localhost:3000/**  e  https://SEU-DOMINIO/**
#
# Atencao: projeto gratuito HIBERNA apos 7 dias sem atividade e o login para
# de funcionar ate alguem reativar no painel. Conferir antes de divulgar.

# ---------------- Tela de admin (/admin) e persistencia de pedidos ----------------
# Quem pode abrir /admin. E-mails da CONTA de login, separados por virgula.
# A comparacao ignora espaco e maiuscula. Vazio = ninguem e admin (404 para todos).
# Nao existe link para /admin na interface: a entrada e digitar a URL.
ADMIN_EMAILS=

# Chave "service_role" (Project Settings > API). Ignora RLS: e o que permite o
# servidor gravar e ler a tabela `pedidos`.
# NUNCA use o prefixo NEXT_PUBLIC_ aqui. Com ele a chave vai para o bundle do
# navegador e qualquer visitante ganha acesso total ao banco, inclusive auth.users.
SUPABASE_SERVICE_ROLE_KEY=
#
# Antes do primeiro uso, rode no painel (SQL Editor) o SQL da tabela `pedidos`
# que esta em docs/superpowers/plans/2026-08-03-telefone-e-admin.md (Task 4).
# A tabela fica com RLS ligada e NENHUMA politica, de proposito: assim a chave
# anon (publica, no navegador) nao consegue listar telefone de terceiros.
#
# Sem a tabela e sem a chave, NENHUMA COMPRA PASSA: o checkout cancela o Pix e
# recusa quando nao consegue gravar o pedido. E o comportamento correto, mas
# confunde se voce esquecer.
