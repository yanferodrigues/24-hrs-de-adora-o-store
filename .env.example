# Copie para .env.local e preencha para ativar o pagamento real (Mercado Pago · Pix).
# Sem esta variável, o botão de compra fica em modo reserva (sem cobrança).
# Pegue o token em: mercadopago.com.br -> Suas integracoes -> Credenciais.
# Cadastre tambem uma CHAVE PIX na sua conta (e onde o dinheiro cai).
# Comece com o token de TESTE para validar sem cobrar de verdade.
MP_ACCESS_TOKEN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Numero do WhatsApp de atendimento (formato internacional, so digitos: 55 + DDD + numero).
# Usado no link "conversar" do rodape. Fica so no .env.local (fora do codigo versionado).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---------------- Login / sessao ----------------
# Segredo que assina o cookie de sessao. Gere um valor longo e aleatorio:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar este valor desloga todo mundo de uma vez.
AUTH_SECRET=

# OAuth do Google. Em console.cloud.google.com:
#   1. Google Auth Platform > Comecar (tipo de usuario: Externo)
#   2. Acesso a dados > escopos: openid, userinfo.email, userinfo.profile
#   3. Publico-alvo > PUBLICAR APLICATIVO  (em modo Teste so entram e-mails
#      cadastrados a mao - o login falha para o resto das pessoas)
#   4. Clientes > Criar cliente > Aplicativo da Web, com estes URIs de
#      redirecionamento autorizados (correspondencia exata, sem barra final):
#         http://localhost:3000/api/auth/google/callback
#         https://SEU-DOMINIO/api/auth/google/callback
# Sem estas duas variaveis o botao "Entrar com Google" nao aparece e o login
# por e-mail/senha continua funcionando normalmente.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------- Banco (Turso / libSQL) ----------------
# O mesmo cliente atende os dois ambientes:
#   local  -> file:data/app.db          (nao precisa de token, nao precisa criar conta)
#   Vercel -> libsql://SEU-BANCO.turso.io  + token do painel do Turso
# Depois de preencher, rode uma vez: npm run db:init
TURSO_DATABASE_URL=file:data/app.db
TURSO_AUTH_TOKEN=
